ANTHROPIC_API_KEY=your_anthropic_key_here

# Solapi 친구톡 발송
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_PF_ID=KA01PFxxxxxxxxxxxxxxxxxxxxxxxx   # 솔라피 > 카카오 채널 ID (KA01PF로 시작)
SOLAPI_SENDER_KEY=your_kakao_sender_key       # (선택) 구버전 호환, pfId와 동일하면 생략 가능
SOLAPI_SENDER_PHONE=01012345678                    # 발신번호 (카카오 채널 대표번호)

# 관리자 대시보드 접근 비밀번호
ADMIN_PASSWORD=your_admin_password

# 로컬 기본값
# DATABASE_URL=sqlite:///./yejinsaem.db
# UPLOAD_DIR=./uploads

# Railway (Volume 마운트 경로 /data)
# DATABASE_URL=sqlite:////data/yejinsaem.db
# UPLOAD_DIR=/data/uploads

# PORT / HOST — Railway가 PORT를 주입함. 로컬만 필요 시:
# PORT=8000
# HOST=0.0.0.0
