ANTHROPIC_API_KEY=your_anthropic_key_here

# Solapi 친구톡 발송
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_SENDER_KEY=your_kakao_channel_sender_key   # 솔라피 > 카카오 채널 연동 후 발급
SOLAPI_SENDER_PHONE=01012345678                    # 발신번호 (카카오 채널 대표번호)

# 카카오 i 오픈빌더 (웹훅 수신 검증용)
KAKAO_CHANNEL_SECRET=your_openbuilder_secret

# Make.com → POST /kakao/make 연동 시 (선택, 설정 시 X-Make-Secret 헤더와 일치해야 함)
# MAKE_WEBHOOK_SECRET=your_random_secret

# 관리자 대시보드 접근 비밀번호
ADMIN_PASSWORD=your_admin_password

# 선택 사항
# DATABASE_URL=sqlite:///./yejinsaem.db
